#. Plugin Name of the plugin
#: loupe-semantic-search.php
#: includes/Abilities.php:46
msgid "Loupe Semantic Search"
msgstr "Loupe Semantic Search"

#. Plugin URI of the plugin
#: loupe-semantic-search.php
msgid "https://github.com/soderlind/loupe-semantic-search"
msgstr ""

#. Description of the plugin
#: loupe-semantic-search.php
msgid "Adds semantic retrieval and hybrid (keyword + meaning) search to Loupe Search, using embeddings from a provider connected under Settings → Connectors."
msgstr "Legger til semantisk gjenfinning og hybridsøk (nøkkelord + betydning) i Loupe Search, med embeddinger fra en leverandør koblet til under Innstillinger → Koblinger."

#. Author of the plugin
#: loupe-semantic-search.php
msgid "Per Soderlind"
msgstr ""

#. Author URI of the plugin
#: loupe-semantic-search.php
msgid "https://soderlind.no"
msgstr ""

#: includes/Abilities.php:47
msgid "Semantic retrieval and hybrid search over Loupe Search content."
msgstr "Semantisk gjenfinning og hybridsøk i innhold fra Loupe Search."

#: includes/Abilities.php:59
msgid "Post type or list of post types. Defaults to all public indexed post types."
msgstr "Innleggstype eller liste over innleggstyper. Standard er alle offentlige, indekserte innleggstyper."

#: includes/Abilities.php:65
msgid "Retrieve Passages"
msgstr "Hent avsnitt"

#: includes/Abilities.php:66
msgid "Find the passages of site content most relevant to a question, by meaning rather than exact words. Returns passage text with source title and URL, for answering with citations."
msgstr "Finn avsnittene i nettstedets innhold som er mest relevante for et spørsmål, etter betydning heller enn eksakte ord. Returnerer avsnittstekst med kildetittel og URL, for svar med kildehenvisninger."

#: includes/Abilities.php:74
msgid "A question or description of the information needed."
msgstr "Et spørsmål eller en beskrivelse av informasjonen du trenger."

#: includes/Abilities.php:78
msgid "Number of passages. Default: 5. Max: 20."
msgstr "Antall avsnitt. Standard: 5. Maks: 20."

#: includes/Abilities.php:100
msgid "Passage text."
msgstr "Avsnittstekst."

#: includes/Abilities.php:101
msgid "Cosine similarity, 0 to 1."
msgstr "Cosinuslikhet, 0 til 1."

#: includes/Abilities.php:102
msgid "True when the post changed since it was embedded and the text is an excerpt."
msgstr "Sann når innlegget er endret siden det ble embeddet, og teksten er et utdrag."

#: includes/Abilities.php:128
msgid "Hybrid Search"
msgstr "Hybridsøk"

#: includes/Abilities.php:129
msgid "Search site content by keywords and meaning combined. Same results format as loupe-search/search."
msgstr "Søk i nettstedets innhold med nøkkelord og betydning kombinert. Samme resultatformat som loupe-search/search."

#: includes/Abilities.php:135
msgid "The search query."
msgstr "Søkespørringen."

#: includes/Abilities.php:139
msgid "Post types to search. Defaults to all public indexed post types."
msgstr "Innleggstyper det skal søkes i. Standard er alle offentlige, indekserte innleggstyper."

#: includes/Abilities.php:203
#: includes/Query_Embedder.php:59
msgid "The query is empty."
msgstr "Spørringen er tom."

#: includes/Admin/Settings_Page.php:104
msgid "Settings"
msgstr "Innstillinger"

#: includes/Admin/Settings_Page.php:113
msgid "You are not allowed to do this."
msgstr "Du har ikke tilgang til å gjøre dette."

#. translators: %s: Connectors screen URL.
#: includes/Admin/Settings_Page.php:148
#, php-format
msgid "Semantic search needs the AI plugin (1.5.0 or later) and a provider that offers embeddings. <a href=\"%s\">Connect a provider</a>."
msgstr "Semantisk søk krever AI-utvidelsen (1.5.0 eller nyere) og en leverandør som tilbyr embeddinger. <a href=\"%s\">Koble til en leverandør</a>."

#: includes/Admin/Settings_Page.php:160
msgid "Embedding model"
msgstr "Embeddingmodell"

#: includes/Admin/Settings_Page.php:163
msgid "Model"
msgstr "Modell"

#: includes/Admin/Settings_Page.php:166
msgid "Changing the model re-embeds all content and deletes the old model’s vectors when nothing else uses them."
msgstr "Bytte av modell embedder alt innhold på nytt og sletter den gamle modellens vektorer når ingenting annet bruker dem."

#: includes/Admin/Settings_Page.php:170
msgid "Dimensions"
msgstr "Dimensjoner"

#: includes/Admin/Settings_Page.php:173
msgid "0 uses the model default. Only for models that support shortened embeddings."
msgstr "0 bruker modellens standard. Bare for modeller som støtter forkortede embeddinger."

#: includes/Admin/Settings_Page.php:178
msgid "Hybrid search"
msgstr "Hybridsøk"

#: includes/Admin/Settings_Page.php:181
msgid "Use on"
msgstr "Bruk på"

#: includes/Admin/Settings_Page.php:184
msgid "Front-end search (and the loupe-search/search ability)"
msgstr "Søk på nettstedet (og evnen loupe-search/search)"

#: includes/Admin/Settings_Page.php:185
msgid "REST search endpoint (Loupe Search Block)"
msgstr "REST-søkeendepunktet (Loupe Search Block)"

#: includes/Admin/Settings_Page.php:186
msgid "Abilities: loupe-semantic/retrieve and loupe-semantic/search"
msgstr "Evner: loupe-semantic/retrieve og loupe-semantic/search"

#: includes/Admin/Settings_Page.php:191
msgid "Weights"
msgstr "Vekter"

#: includes/Admin/Settings_Page.php:193
msgid "Keyword"
msgstr "Nøkkelord"

#: includes/Admin/Settings_Page.php:196
msgid "Semantic"
msgstr "Semantisk"

#: includes/Admin/Settings_Page.php:198
msgid "Relative weight of each ranking in reciprocal rank fusion."
msgstr "Relativ vekt for hver rangering i resiprok rangfusjon."

#: includes/Admin/Settings_Page.php:202
msgid "Minimum similarity"
msgstr "Minste likhet"

#: includes/Admin/Settings_Page.php:205
msgid "Semantic matches below this cosine similarity are ignored."
msgstr "Semantiske treff under denne cosinuslikheten ignoreres."

#: includes/Admin/Settings_Page.php:210
msgid "Limits"
msgstr "Grenser"

#: includes/Admin/Settings_Page.php:213
msgid "Per visitor"
msgstr "Per besøkende"

#: includes/Admin/Settings_Page.php:216
msgid "query embeddings per minute per IP address (0 = no limit)"
msgstr "spørringsembeddinger per minutt per IP-adresse (0 = ingen grense)"

#: includes/Admin/Settings_Page.php:220
msgid "Daily cap"
msgstr "Daglig tak"

#. translators: %d: query embeddings used today.
#: includes/Admin/Settings_Page.php:226
#, php-format
msgid "query embeddings per day for the whole site (0 = no limit). Used today: %d."
msgstr "spørringsembeddinger per dag for hele nettstedet (0 = ingen grense). Brukt i dag: %d."

#: includes/Admin/Settings_Page.php:230
msgid "Cached queries do not count. When a limit is reached, search falls back to keyword results."
msgstr "Hurtigbufrede spørringer telles ikke. Når en grense er nådd, faller søket tilbake til nøkkelordtreff."

#. translators: %s: Connectors screen URL.
#: includes/Admin/Settings_Page.php:258
#, php-format
msgid "No connected provider offers embedding models. <a href=\"%s\">Connect a provider</a>."
msgstr "Ingen tilkoblet leverandør tilbyr embeddingmodeller. <a href=\"%s\">Koble til en leverandør</a>."

#: includes/Admin/Settings_Page.php:269
msgid "— Select a model —"
msgstr "— Velg en modell —"

#. translators: %s: provider::model.
#: includes/Admin/Settings_Page.php:272
#, php-format
msgid "%s (not available)"
msgstr "%s (ikke tilgjengelig)"

#: includes/Admin/Settings_Page.php:309
msgid "Backfill started."
msgstr "Etterfylling startet."

#: includes/Admin/Settings_Page.php:310
msgid "Backfill cancelled."
msgstr "Etterfylling avbrutt."

#: includes/Admin/Settings_Page.php:311
msgid "Backfill restarted from the beginning."
msgstr "Etterfylling startet på nytt fra begynnelsen."

#: includes/Admin/Settings_Page.php:312
msgid "The backfill action did not run. Is a model selected?"
msgstr "Etterfyllingen ble ikke kjørt. Er en modell valgt?"

#: includes/Admin/Settings_Page.php:325
msgid "Index status"
msgstr "Indeksstatus"

#: includes/Admin/Settings_Page.php:327
msgid "Choose a model and save to start embedding content."
msgstr "Velg en modell og lagre for å begynne å embedde innhold."

#: includes/Admin/Settings_Page.php:331
msgid "Post type"
msgstr "Innleggstype"

#: includes/Admin/Settings_Page.php:331
msgid "Embedded"
msgstr "Embeddet"

#: includes/Admin/Settings_Page.php:331
msgid "Indexable"
msgstr "Indekserbare"

#: includes/Admin/Settings_Page.php:345
msgid "Backfill"
msgstr "Etterfylling"

#: includes/Admin/Settings_Page.php:345
msgid "not started"
msgstr "ikke startet"

#: includes/Admin/Settings_Page.php:346
msgid "Queue"
msgstr "Kø"

#. translators: 1: pending objects, 2: failed objects.
#: includes/Admin/Settings_Page.php:348
#, php-format
msgid "%1$d pending, %2$d failed"
msgstr "%1$d venter, %2$d feilet"

#: includes/Admin/Settings_Page.php:352
msgid "Last run"
msgstr "Siste kjøring"

#: includes/Admin/Settings_Page.php:352
msgid "never"
msgstr "aldri"

#: includes/Admin/Settings_Page.php:355
msgid "Paused until"
msgstr "Satt på pause til"

#: includes/Admin/Settings_Page.php:358
msgid "Provider error"
msgstr "Leverandørfeil"

#: includes/Admin/Settings_Page.php:370
msgid "Cancel backfill"
msgstr "Avbryt etterfylling"

#: includes/Admin/Settings_Page.php:372
msgid "Start backfill"
msgstr "Start etterfylling"

#: includes/Admin/Settings_Page.php:374
msgid "Reset and re-run"
msgstr "Nullstill og kjør på nytt"

#: includes/Ai_Adapter.php:92
msgid "Embedding generation is not available."
msgstr "Generering av embeddinger er ikke tilgjengelig."

#: includes/Ai_Adapter.php:107
msgid "The provider returned no embedding."
msgstr "Leverandøren returnerte ingen embedding."

#: includes/Plugin.php:208
msgid "Loupe Semantic Search needs Loupe Search 1.5.0 or later."
msgstr "Loupe Semantic Search krever Loupe Search 1.5.0 eller nyere."

#. translators: %s: Connectors screen URL.
#: includes/Plugin.php:212
#, php-format
msgid "Loupe Semantic Search needs the AI plugin (1.5.0 or later) and a provider that offers embeddings. <a href=\"%s\">Connect a provider</a>."
msgstr "Loupe Semantic Search krever AI-utvidelsen (1.5.0 eller nyere) og en leverandør som tilbyr embeddinger. <a href=\"%s\">Koble til en leverandør</a>."

#. translators: %s: settings page URL.
#: includes/Plugin.php:220
#, php-format
msgid "Loupe Semantic Search is inactive until you <a href=\"%s\">choose an embedding model</a>."
msgstr "Loupe Semantic Search er inaktiv til du <a href=\"%s\">velger en embeddingmodell</a>."

#: includes/Query_Embedder.php:69
msgid "The semantic search limit has been reached."
msgstr "Grensen for semantisk søk er nådd."

#: includes/Retriever.php:44
msgid "No embedding model is selected."
msgstr "Ingen embeddingmodell er valgt."

#: includes/Admin/Settings_Page.php:80
